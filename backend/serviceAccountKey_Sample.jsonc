// Rename this file to serviceAccountKey.json and fill in the values
// with your own service account credentials.
// You can generate a new service account key in the Google Cloud Console:
// https://console.cloud.google.com/apis/credentials/serviceaccountkey
// Make sure to replace the placeholder values with your actual credentials.
// This is a sample service account key file for Firebase Admin SDK.
// The private key should be kept secret and not shared publicly.
// The private key is used to authenticate your application to Firebase services.

{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "ENTER_YOUR_KEY_ID",
  "private_key": "-----ENTER YOUR PRIVATE KEY-----",
  "client_email": "ENTER_YOUR_CLIENT_EMAIL",
  "client_id": "ENTER_YOUR_CLIENT_ID",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/your-client-email",
  "universe_domain": "googleapis.com"
}
